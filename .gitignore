.env
pacto-bot-api.toml
data/

# Seed deployment artifacts and build cache are produced locally; never commit
# generated state.
data/deployments/
data/cache/

# Generated dev-world state. The manifest is reproducible from worlds/*.world.json
# and the secret sidecar is signing material; neither is ever committed. Named
# explicitly so narrowing the data/ rule cannot expose the sidecar.
data/world/
**/world-secrets.json

# Python bytecode — never commit interpreter caches.
__pycache__/
*.py[cod]
